# Copiar este archivo a .env.local y reemplazar el valor por la cadena
# de conexión *pooled* del proyecto de Neon. No subir .env.local ni
# credenciales reales al repositorio.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-POOLER.REGION.AWS.NEON.TECH/BASE?sslmode=require

# Generar el secreto local con pnpm auth:setup. No subir el valor real.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
